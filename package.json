{
  "name": "dsh-agent-lab",
  "version": "0.4.0",
  "private": true,
  "description": "Agent 行为回归实验台：录制/重放会话运行，按任务×变体聚合矩阵，并用任务断言与 CI 退出码做回归门禁",
  "type": "module",
  "main": "index.js",
  "bin": {
    "agent-lab-check": "./bin/agent-lab-check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bin",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
